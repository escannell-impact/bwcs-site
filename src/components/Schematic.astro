---
/** Representative engagement schematics. No client data; structure only. */
interface Props { slug: string }
const { slug } = Astro.props;

const C = {
  label: '#8A8781', line: '#A9A296', text: '#5C6167',
  boxFill: '#EDEAE3', boxLine: '#D2CCC0',
  blueFill: '#E3E7EF', blueLine: '#8E9BB5', indigo: '#3B4A6B', paper: '#F7F5F0', paleText: '#B6BECF',
  sandFill: '#F3EADB', sandLine: '#D6C9B2', amberText: '#8A5214',
};
const SANS = 'Archivo, sans-serif';
const MONO = 'IBM Plex Mono, monospace';

const regions = [
  { x: 8, name: 'Asia-Pacific' },
  { x: 132, name: 'EMEA' },
  { x: 256, name: 'North America' },
];
---
<figure class="fig">
  {slug === 'defense-aerospace-platform-consolidation' && (
    <svg viewBox="0 0 380 236" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Change governance: request, risk assessment, CAB review and post-implementation review, with rolling release windows and P1/P2 incidents down 20%">
      <text x="8" y="14" font-family={MONO} font-size="10" fill={C.label}>Change governance</text>
      <g font-family={SANS} font-size="10.5" text-anchor="middle">
        <rect x="8" y="28" width="104" height="32" rx="3" fill={C.boxFill} stroke={C.boxLine} stroke-width=".8" />
        <text x="60" y="48" fill={C.text}>Request raised</text>
        <rect x="8" y="78" width="104" height="32" rx="3" fill={C.blueFill} stroke={C.blueLine} stroke-width=".8" />
        <text x="60" y="98" fill={C.indigo}>Risk assessed</text>
        <rect x="8" y="128" width="104" height="32" rx="3" fill={C.indigo} />
        <text x="60" y="148" fill={C.paper}>CAB review</text>
        <rect x="8" y="178" width="104" height="32" rx="3" fill={C.sandFill} stroke={C.sandLine} stroke-width=".8" />
        <text x="60" y="198" fill={C.amberText}>Post-implementation</text>
      </g>
      <g stroke={C.line} fill="none"><path d="M60 60V74M60 110V124M60 160V174" /></g>
      <g fill={C.line}><path d="M60 74l-2.5-5h5zM60 124l-2.5-5h5zM60 174l-2.5-5h5z" /></g>
      <text x="140" y="34" font-family={MONO} font-size="9.5" fill={C.label}>Release windows, rolling four weeks</text>
      <rect x="140" y="42" width="232" height="1" fill="#DED9CF" />
      <g>
        <rect x="140" y="50" width="52" height="14" rx="2" fill="#C9D2E2" /><rect x="200" y="50" width="34" height="14" rx="2" fill="#C9D2E2" /><rect x="242" y="50" width="70" height="14" rx="2" fill={C.indigo} /><rect x="320" y="50" width="40" height="14" rx="2" fill="#C9D2E2" />
        <rect x="140" y="70" width="34" height="14" rx="2" fill="#E8D9BE" /><rect x="182" y="70" width="62" height="14" rx="2" fill="#E8D9BE" /><rect x="252" y="70" width="44" height="14" rx="2" fill="#E8D9BE" />
        <rect x="140" y="90" width="76" height="14" rx="2" fill="#E0DCD3" /><rect x="224" y="90" width="48" height="14" rx="2" fill="#E0DCD3" /><rect x="280" y="90" width="60" height="14" rx="2" fill="#E0DCD3" />
      </g>
      <g font-family={MONO} font-size="9" fill={C.line}>
        <rect x="140" y="116" width="8" height="8" rx="1" fill="#C9D2E2" /><text x="152" y="123">Standard</text>
        <rect x="206" y="116" width="8" height="8" rx="1" fill="#E8D9BE" /><text x="218" y="123">Normal</text>
        <rect x="266" y="116" width="8" height="8" rx="1" fill="#E0DCD3" /><text x="278" y="123">Emergency</text>
      </g>
      <text x="140" y="160" font-family={SANS} font-size="10.5" fill={C.text}>P1/P2 incidents</text>
      <rect x="140" y="170" width="200" height="8" rx="2" fill="#E0DCD3" />
      <rect x="140" y="170" width="160" height="8" rx="2" fill={C.indigo} />
      <text x="140" y="196" font-family={MONO} font-size="9" fill={C.line}>−20% across 12 critical systems</text>
    </svg>
  )}

  {slug === 'telecom-tni-spm-program' && (
    <svg viewBox="0 0 380 236" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="One program governing two workstreams: network inventory leading to faster outage response, and portfolio management leading to better resource allocation">
      <text x="8" y="14" font-family={MONO} font-size="10" fill={C.label}>Program structure</text>
      <g font-family={SANS} font-size="10.5" text-anchor="middle">
        <rect x="8" y="26" width="364" height="34" rx="3" fill={C.indigo} />
        <text x="190" y="47" fill={C.paper}>Program governance, one cadence for 30 people</text>

        <text x="97" y="84" font-family={MONO} font-size="9.5" fill={C.label}>Network inventory</text>
        <rect x="16" y="94" width="162" height="30" rx="3" fill={C.blueFill} stroke={C.blueLine} stroke-width=".8" />
        <text x="97" y="113" fill={C.indigo}>Inventory of record</text>
        <rect x="16" y="140" width="162" height="30" rx="3" fill={C.boxFill} stroke={C.boxLine} stroke-width=".8" />
        <text x="97" y="159" fill={C.text}>Outage detection and routing</text>
        <rect x="16" y="186" width="162" height="30" rx="3" fill={C.sandFill} stroke={C.sandLine} stroke-width=".8" />
        <text x="97" y="205" fill={C.amberText}>Outages −25%</text>

        <text x="283" y="84" font-family={MONO} font-size="9.5" fill={C.label}>Portfolio management</text>
        <rect x="202" y="94" width="162" height="30" rx="3" fill={C.blueFill} stroke={C.blueLine} stroke-width=".8" />
        <text x="283" y="113" fill={C.indigo}>Single intake and scoring</text>
        <rect x="202" y="140" width="162" height="30" rx="3" fill={C.boxFill} stroke={C.boxLine} stroke-width=".8" />
        <text x="283" y="159" fill={C.text}>Resource allocation across teams</text>
        <rect x="202" y="186" width="162" height="30" rx="3" fill={C.sandFill} stroke={C.sandLine} stroke-width=".8" />
        <text x="283" y="205" fill={C.amberText}>Completion rate +15%</text>
      </g>
      <g stroke={C.line} fill="none"><path d="M97 60V70M283 60V70M97 124V136M97 170V182M283 124V136M283 170V182" /></g>
      <g fill={C.line}><path d="M97 136l-2.5-5h5zM97 182l-2.5-5h5zM283 136l-2.5-5h5zM283 182l-2.5-5h5z" /></g>
    </svg>
  )}

  {slug === 'cybersecurity-cloud-security-program' && (
    <svg viewBox="0 0 380 236" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Account updates from three regions roll up weekly into one leadership view of commitments, progress and risk; the top 100 strategic accounts are tracked individually">
      <text x="8" y="14" font-family={MONO} font-size="10" fill={C.label}>Weekly roll-up, three regions</text>
      {regions.map((r) => (
        <g>
          <text x={r.x + 58} y="36" text-anchor="middle" font-family={SANS} font-size="10.5" fill={C.text}>{r.name}</text>
          {Array.from({ length: 24 }, (_, i) => (
            <rect x={r.x + 6 + (i % 8) * 13.5} y={46 + Math.floor(i / 8) * 13.5} width="10" height="10" rx="1.5"
              fill={i < 4 ? C.indigo : '#D9D4CA'} />
          ))}
        </g>
      ))}
      <g stroke={C.line} fill="none"><path d="M66 92V108H190M190 92V122M314 92V108H190" /></g>
      <path d="M190 122l-2.5-5h5z" fill={C.line} />
      <g font-family={SANS} font-size="10.5" text-anchor="middle">
        <rect x="110" y="126" width="160" height="30" rx="3" fill={C.blueFill} stroke={C.blueLine} stroke-width=".8" />
        <text x="190" y="145" fill={C.indigo}>Week-over-week updates</text>
        <rect x="70" y="172" width="240" height="40" rx="3" fill={C.indigo} />
        <text x="190" y="189" fill={C.paper}>One leadership view</text>
        <text x="190" y="204" fill={C.paleText} font-size="9.5">Commitments, progress and risk</text>
      </g>
      <path d="M190 156V168" stroke={C.line} /><path d="M190 168l-2.5-5h5z" fill={C.line} />
      <g font-family={MONO} font-size="9" fill={C.line}>
        <rect x="8" y="224" width="8" height="8" rx="1" fill={C.indigo} /><text x="20" y="231">Top 100 strategic accounts, each above $5M ARR</text>
      </g>
    </svg>
  )}
  <figcaption>Schematic of the engagement's structure. No client data.</figcaption>
</figure>

<style>
  .fig { margin: 0; border: 1px solid var(--rule); border-radius: 3px; background: #FBFAF7; padding: 18px 16px 12px; }
  .fig svg { width: 100%; height: auto; }
  figcaption { font-size: 12px; color: var(--mute); text-align: center; margin-top: 10px; }
</style>
